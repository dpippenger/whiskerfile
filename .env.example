# Cloudflare Zero Trust team domain, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag of the Access application
CF_ACCESS_AUD=
# Token of the Cloudflare tunnel whose public hostname points at http://app:3000
TUNNEL_TOKEN=

# Where backups are written; point this at a different disk or NAS share
BACKUP_PATH=./backups
# Backup schedule (cron syntax) and the time zone it is read in
BACKUP_CRON=0 3 * * *
TZ=UTC

# Optional: an Anthropic API key lets the lab form read results from a PDF or
# photo of a report. Documents you read this way are sent to Anthropic's API.
ANTHROPIC_API_KEY=

# User and group the app runs as; they must own ./data and the backup folder.
# Set these to the output of `id -u` and `id -g` if yours are not 1000.
APP_UID=1000
APP_GID=1000
