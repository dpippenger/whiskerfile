{
  "name": "whiskerfile",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "AUTH_MODE=dev bun --hot src/server/index.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "test": "bun test",
    "typecheck": "bun check",
    "lint": "sh scripts/lint.sh",
    "check:unused": "knip",
    "check:migrations": "drizzle-kit check && drizzle-kit generate && test -z \"$(git status --porcelain drizzle)\"",
    "db:generate": "drizzle-kit generate",
    "seed:dev": "bun scripts/seed-dev.ts",
    "read:lab": "bun scripts/read-lab.ts",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.11",
    "husky": "9.1.7",
    "knip": "6.46.1",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.108.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "echarts": "6.1.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "{src,scripts}/**": "prettier --write --ignore-unknown",
    "*.{ts,tsx}": "sh scripts/lint.sh"
  }
}
